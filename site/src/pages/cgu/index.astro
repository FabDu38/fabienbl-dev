---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
---

<BaseLayout
  title="Conditions générales d'utilisation | Fabien Blasquez"
  description="Conditions générales d'utilisation du site fabien-blasquez.dev."
  path="/cgu/"
>
  <PageHero eyebrow="Informations" title="Conditions générales d'utilisation" />
  <div class="page-body">
    <div class="card empty-state reveal">
      <div class="card-icon"><Icon name="file" size={24} /></div>
      <div class="empty-state-body">
        <h2>En cours de rédaction</h2>
        <p>Conditions générales d'utilisation à venir.</p>
      </div>
    </div>
  </div>
</BaseLayout>
