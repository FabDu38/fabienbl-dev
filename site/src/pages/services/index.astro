---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaPanel from '../../components/CtaPanel.astro';

const services = [
  {
    id: 'creer',
    title: 'Créer une application métier',
    text: 'Concevoir et développer une application sur mesure, adaptée aux besoins et aux usages de vos équipes.',
  },
  {
    id: 'evoluer',
    title: 'Faire évoluer un outil existant',
    text: 'Reprendre votre application pour la fiabiliser, améliorer son utilisation et développer de nouvelles fonctionnalités.',
  },
  {
    id: 'automatiser',
    title: 'Automatiser vos tâches et intégrer l’IA',
    text: 'Réduire les ressaisies, automatiser les échanges entre vos outils et intégrer des fonctions d’IA adaptées à vos besoins.',
  },
  {
    id: 'cadrer',
    title: 'Cadrer et piloter un projet numérique',
    text: 'Clarifier vos besoins, définir les priorités et coordonner la réalisation, y compris lorsque le développement est confié à d’autres intervenants.',
  },
];
---

<BaseLayout
  title="Services | Fabien Blasquez"
  description="Créer une application métier, faire évoluer un outil, automatiser vos tâches et intégrer l’IA, cadrer et piloter un projet numérique."
  path="/services/"
>
  <PageHero
    eyebrow="Services"
    title="Services"
    lead="Quatre façons d’intervenir : construire une application métier, la faire évoluer, automatiser vos tâches et intégrer l’IA, ou cadrer et piloter le projet."
  />

  <div class="page-body">
    <ol class="steps reveal">
      {
        services.map((service) => (
          <li id={service.id}>
            <strong>{service.title}</strong>
            {service.text}
          </li>
        ))
      }
    </ol>

    <section class="prose-section reveal">
      <h2>Méthode et preuves</h2>
      <div class="prose">
        <p>
          La façon de travailler est décrite sur la page <a href="/a-propos/">À propos</a>. Les contextes
          déjà menés sont sur <a href="/projets/professionnels/">Projets professionnels</a>.
        </p>
      </div>
    </section>

    <CtaPanel compact />
  </div>
</BaseLayout>
