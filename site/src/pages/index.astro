---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import CtaPanel from '../components/CtaPanel.astro';
import { personLd, websiteLd } from '../data/jsonLd';

const title = 'Développeur Web Freelance | Applications sur mesure';
const description =
  "Développeur freelance avec 20 ans d'expérience. Applications web et métier sur mesure — solutions claires et durables.";

const services = [
  { href: '/services/#creer', title: 'Créer une application métier' },
  { href: '/services/#evoluer', title: 'Faire évoluer un outil existant' },
  { href: '/services/#automatiser', title: 'Automatiser des tâches et des échanges de données' },
  { href: '/services/#cadrer', title: 'Cadrer et piloter un projet numérique' },
];
---

<BaseLayout
  title={title}
  description={description}
  path="/"
  jsonLd={[personLd, websiteLd]}
>
  <section class="hero">
    <div class="hero-inner reveal">
      <p class="eyebrow eyebrow--pill">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        Développeur freelance · 20 ans d'expérience
      </p>
      <h1>
        Des applications sur mesure, <span class="text-gradient">utiles aujourd'hui</span> et durables
        dans le temps.
      </h1>
      <p class="lead">
        J'accompagne vos projets de l'idée à une solution concrète et durable, adaptée aux enjeux réels
        de votre activité.
      </p>
      <p class="body">
        Freelance développeur multiplateforme avec 20 ans d'expérience, je travaille à distance sur des
        projets web, mobile et desktop.
      </p>
      <div class="hero-actions">
        <a class="btn-primary" href="/contact/">
          Parlons de votre projet
          <Icon name="arrow-right" size={18} />
        </a>
        <a class="btn-secondary" href="/services/">Voir les services</a>
      </div>
      <p class="hint">Un premier échange pour clarifier votre besoin et définir la suite.</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section-inner">
      <div class="section-header reveal">
        <p class="eyebrow">Services</p>
        <h2>Ce que je peux prendre en charge</h2>
        <p>D’abord les applications métier, et aussi le cadrage et le pilotage d’un projet.</p>
      </div>
      <ul class="service-links reveal">
        {
          services.map((service) => (
            <li>
              <a href={service.href}>{service.title}</a>
            </li>
          ))
        }
      </ul>
      <p class="reveal">
        <a class="btn-secondary" href="/services/">Voir le détail des services</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <div class="section-header reveal">
        <p class="eyebrow">Expérience</p>
        <h2>Une expérience solide, au service de projets concrets</h2>
        <p>
          Startups, PME, grands groupes : des contextes différents, le même objectif — faire simple,
          utile et durable.
        </p>
      </div>
      <div class="highlight-grid reveal">
        <div class="stat-card">
          <p class="stat-value">20+</p>
          <p class="stat-label">ans d'expérience</p>
          <p class="stat-sub">Startups · PME · grands groupes</p>
        </div>
        <article class="card">
          <ul class="check-list check-list--2col">
            <li>Plus de 20 ans d'expérience dans le développement de solutions numériques</li>
            <li>Des projets menés dans des contextes variés : startups, PME et grands groupes</li>
            <li>Une approche pragmatique, centrée sur l'usage et la réalité du terrain</li>
            <li>Un accompagnement direct du premier échange jusqu'à une solution utilisable</li>
          </ul>
        </article>
      </div>
      <div class="project-grid reveal">
        <article class="card project-card">
          <p class="project-kicker">Applications et outils métier</p>
          <h3>Projets professionnels</h3>
          <p>Contextes menés en entreprise, du cadrage à la mise en production.</p>
          <div class="card-footer">
            <a class="card-link" href="/projets/professionnels/">
              Voir les projets professionnels <Icon name="arrow-right" size={18} />
            </a>
          </div>
        </article>
        <article class="card project-card">
          <p class="project-kicker">Cas de projet</p>
          <h3>Élan</h3>
          <p>Présentation à venir. Pas de démo publique.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section-inner">
      <div class="section-header reveal">
        <p class="eyebrow">Collaboration</p>
        <h2>Façon de travailler</h2>
        <p>Du sur-mesure, de la clarté, et des outils qui restent utiles dans le temps.</p>
      </div>
      <ul class="check-list reveal">
        <li>
          <strong>Sur-mesure utile.</strong> Chaque solution est pensée pour répondre à un besoin précis.
          Juste ce qui sert vraiment.
        </li>
        <li>
          <strong>Clarté et simplicité.</strong> Un cadre clair, des échanges directs, des décisions
          compréhensibles. Vous savez à tout moment où en est le projet.
        </li>
        <li>
          <strong>Pensé pour durer.</strong> Des bases solides, une maintenance raisonnable et des
          évolutions possibles.
        </li>
      </ul>
    </div>
  </section>

  <section class="section">
    <CtaPanel
      title="On en parle ?"
      text="Un premier échange pour comprendre votre besoin et voir si je suis la bonne personne pour vous accompagner."
      hint="Je vous réponds rapidement avec une proposition claire et des prochaines étapes."
    />
  </section>
</BaseLayout>
