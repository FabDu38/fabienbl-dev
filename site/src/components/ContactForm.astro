---
import Icon from './Icon.astro';
---

<form id="contact-form" class="card form-card" novalidate aria-labelledby="contact-form-title">
  <h2 id="contact-form-title">Envoyer un message</h2>
  <p class="hint form-intro">Quelques lignes suffisent pour démarrer l'échange.</p>
  <div class="form-row">
    <div class="form-field">
      <label for="name">Nom</label>
      <input
        id="name"
        name="name"
        type="text"
        required
        autocomplete="name"
        placeholder="Votre nom"
      />
    </div>
    <div class="form-field">
      <label for="email">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="vous@exemple.fr"
      />
    </div>
  </div>
  <div class="form-field form-field--grow">
    <label for="message">Message</label>
    <textarea
      id="message"
      name="message"
      rows="6"
      required
      placeholder="Décrivez votre besoin, votre contexte, vos délais…"></textarea>
  </div>
  <button type="submit" class="btn-primary btn-block" data-submit>
    <span data-submit-label>Envoyer mon message</span>
    <Icon name="arrow-right" size={18} />
  </button>
  <p class="form-privacy">
    <Icon name="lock" size={16} />
    <span>
      Les informations saisies sont utilisées pour répondre à votre demande et suivre votre projet
      éventuel. Les demandes sans suite sont conservées pendant 12 mois après le dernier échange. Pour
      en savoir plus sur le traitement de vos données et vos droits, consultez la
      <a href="/confidentialite/">politique de confidentialité</a>.
    </span>
  </p>
  <div id="form-status" class="form-status" hidden role="status" aria-live="polite"></div>
</form>

<script>
  const SERVICE_ID = 'service_3ehoqgp';
  const TEMPLATE_ID = 'template_n0s20gd';
  const PUBLIC_KEY = '9K8EyS_guLUXp0WnX';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusEl = document.getElementById('form-status') as HTMLDivElement;
  const submitBtn = form?.querySelector<HTMLButtonElement>('[data-submit]');
  const submitLabel = form?.querySelector<HTMLSpanElement>('[data-submit-label]');

  function setSending(sending: boolean) {
    if (!submitBtn || !submitLabel) return;
    submitBtn.disabled = sending;
    submitLabel.textContent = sending ? 'Envoi en cours…' : 'Envoyer mon message';
  }

  function showStatus(message: string, type: 'error' | 'success') {
    statusEl.hidden = false;
    statusEl.className = `form-status ${type}`;
    statusEl.textContent = message;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    statusEl.hidden = true;

    const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    const message = (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim();

    if (!name || !email || !message) {
      showStatus('Veuillez remplir tous les champs.', 'error');
      return;
    }

    const body = {
      service_id: SERVICE_ID,
      template_id: TEMPLATE_ID,
      user_id: PUBLIC_KEY,
      template_params: {
        from_name: name,
        from_email: email,
        message,
      },
    };

    setSending(true);
    try {
      const res = await fetch('https://api.emailjs.com/api/v1.0/email/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });

      if (res.ok) {
        showStatus('Message envoyé. Je vous réponds rapidement.', 'success');
        form.reset();
        document.dispatchEvent(new CustomEvent('contact-sent'));
        return;
      }

      const text = await res.text();
      let msg = 'Une erreur est survenue. Réessayez ou contactez-moi par email.';
      if (res.status === 412) {
        msg =
          'Erreur de configuration EmailJS (412). Essayez plus tard ou écrivez à contact@fabien-blasquez.dev.';
      } else if (res.status === 403) {
        msg = 'Accès refusé (domaine ou clé EmailJS). Utilisez contact@fabien-blasquez.dev.';
      }
      console.error('EmailJS', res.status, text);
      showStatus(msg, 'error');
    } catch (err) {
      console.error(err);
      showStatus('Erreur réseau. Réessayez ou contactez-moi par email.', 'error');
    } finally {
      setSending(false);
    }
  });
</script>
