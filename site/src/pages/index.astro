---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import CtaPanel from '../components/CtaPanel.astro';
import { personLd, websiteLd } from '../data/jsonLd';

const title = 'Fabien Blasquez — Développeur freelance & solutions IA';
const description =
  'Applications métier sur mesure, automatisation et intégration d’IA. Développeur freelance avec 20 ans d’expérience, du cadrage à la mise en œuvre.';

const services = [
  { href: '/services/#creer', title: 'Créer une application métier' },
  { href: '/services/#evoluer', title: 'Faire évoluer un outil existant' },
  { href: '/services/#automatiser', title: 'Automatiser vos tâches et intégrer l’IA' },
  { href: '/services/#cadrer', title: 'Cadrer et piloter un projet numérique' },
];
---

<BaseLayout
  title={title}
  description={description}
  path="/"
  jsonLd={[personLd, websiteLd]}
>
  <section class="hero">
    <div class="hero-layout">
      <div class="hero-copy reveal">
        <p class="eyebrow eyebrow--pill">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          Développeur freelance · 20 ans d'expérience
        </p>
        <h1>
          Des applications métier sur mesure, avec <span class="text-gradient">l’IA au service</span> de
          vos projets.
        </h1>
        <p class="lead">
          Je conçois et fais évoluer vos outils, automatise vos tâches et intègre l’IA là où elle
          apporte une réponse concrète à vos besoins.
        </p>
        <p class="body">
          Développeur freelance avec 20 ans d’expérience, j’associe expertise métier et outils d’IA
          pour accompagner vos projets, du cadrage à la mise en œuvre.
        </p>
        <div class="hero-actions">
          <a class="btn-primary" href="/contact/">
            Parlons de votre projet
            <Icon name="arrow-right" size={18} />
          </a>
          <a class="btn-secondary" href="/services/">Voir les services</a>
        </div>
        <p class="hint">Un premier échange pour clarifier votre besoin et définir la suite.</p>
      </div>
      <div class="hero-visual reveal" aria-hidden="true">
        <div class="activity">
          <ol class="activity-steps">
            <li class="activity-step">
              <span class="activity-index">1</span>
              <span class="activity-label">
                <strong>Cadrer</strong>
                <span>Le besoin</span>
              </span>
            </li>
            <li class="activity-step">
              <span class="activity-index">2</span>
              <span class="activity-label">
                <strong>Créer</strong>
                <span>L’application</span>
              </span>
            </li>
            <li class="activity-step">
              <span class="activity-index">3</span>
              <span class="activity-label">
                <strong>Faire évoluer</strong>
                <span>L’outil</span>
              </span>
            </li>
            <li class="activity-step">
              <span class="activity-index">4</span>
              <span class="activity-label">
                <strong>Automatiser</strong>
                <span>Tâches et IA</span>
              </span>
            </li>
          </ol>
          <div class="activity-app">
            <p class="activity-app-title">Application métier</p>
            <span class="activity-bar"></span>
            <span class="activity-bar"></span>
            <span class="activity-bar"></span>
            <span class="activity-ai">IA</span>
          </div>
        </div>
        <p class="hero-visual-caption">Du cadrage à un outil en service</p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section-inner">
      <div class="section-header reveal">
        <p class="eyebrow">Services</p>
        <h2>Ce que je peux prendre en charge</h2>
        <p>D’abord les applications métier, et aussi le cadrage et le pilotage d’un projet.</p>
      </div>
      <ul class="service-links reveal">
        {
          services.map((service) => (
            <li>
              <a href={service.href}>{service.title}</a>
            </li>
          ))
        }
      </ul>
      <p class="section-more reveal">
        <a href="/services/">
          Voir le détail des services
          <Icon name="arrow-right" size={18} />
        </a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <div class="section-header reveal">
        <p class="eyebrow">Expérience</p>
        <h2>Une expérience solide, au service de projets concrets</h2>
        <p>
          Startups, PME, grands groupes : des contextes différents, le même objectif — faire simple,
          utile et durable.
        </p>
      </div>
      <div class="highlight-grid reveal">
        <div class="stat-card">
          <p class="stat-value">20+</p>
          <p class="stat-label">ans d'expérience</p>
          <p class="stat-sub">Startups · PME · grands groupes</p>
        </div>
        <article class="card">
          <ul class="check-list check-list--2col">
            <li>Plus de 20 ans d'expérience dans le développement de solutions numériques</li>
            <li>Des projets menés dans des contextes variés : startups, PME et grands groupes</li>
            <li>Une approche pragmatique, centrée sur l'usage et la réalité du terrain</li>
            <li>Un accompagnement direct du premier échange jusqu'à une solution utilisable</li>
          </ul>
        </article>
      </div>
      <p class="section-more reveal">
        <a href="/projets/">
          Voir les projets
          <Icon name="arrow-right" size={18} />
        </a>
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section-inner">
      <div class="section-header reveal">
        <p class="eyebrow">Collaboration</p>
        <h2>Façon de travailler</h2>
      </div>
      <ul class="check-list reveal">
        <li>
          <strong>Partir de vos usages.</strong> Comprendre vos besoins et vos contraintes pour
          construire un outil adapté au travail de vos équipes.
        </li>
        <li>
          <strong>Utiliser l’IA à bon escient.</strong> Associer mon expérience aux outils d’IA pour
          concevoir vos applications et intégrer les fonctions utiles à votre activité.
        </li>
        <li>
          <strong>Préparer la suite.</strong> Penser dès le départ à la maintenance, aux évolutions et
          à la reprise de l’outil par d’autres intervenants.
        </li>
      </ul>
    </div>
  </section>

  <section class="section">
    <CtaPanel
      title="On en parle ?"
      text="Un premier échange pour comprendre votre besoin et voir si je suis la bonne personne pour vous accompagner."
      hint="Je vous réponds rapidement avec une proposition claire et des prochaines étapes."
    />
  </section>
</BaseLayout>
