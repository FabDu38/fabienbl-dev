---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import Icon from '../../components/Icon.astro';
---

<BaseLayout
  title="Projets | Fabien Blasquez"
  description="Projets professionnels et cas Élan : expérience, démarche et contextes d'intervention."
  path="/projets/"
>
  <PageHero
    eyebrow="Réalisations"
    title="Projets"
    lead="Les projets présentés ici illustrent mon expérience et ma façon de concevoir des outils numériques : des réalisations professionnelles et un projet personnel."
  />

  <div class="page-body">
    <div class="project-grid">
      <article class="card project-card reveal">
        <p class="project-kicker">Applications et outils métier</p>
        <h2>Projets professionnels</h2>
        <p>
          Projets réalisés en environnement entreprise, sur des applications et outils métier, du
          cadrage à la mise en production.
        </p>
        <div class="card-footer">
          <ul class="tags">
            <li class="tag">Applications métier</li>
            <li class="tag">Contexte industriel</li>
          </ul>
          <a class="card-link" href="/projets/professionnels/">
            Voir le détail <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </article>

      <article class="card project-card reveal">
        <p class="project-kicker">Projet personnel</p>
        <h2>Élan — L’IA au service du projet professionnel</h2>
        <p>
          Une application qui associe IA et données métiers pour comprendre sa situation, explorer des
          pistes et être accompagné dans son projet professionnel.
        </p>
        <div class="card-footer">
          <a class="card-link" href="/projets/elan/">
            Découvrir le projet <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </article>
    </div>

    <CtaPanel compact />
  </div>
</BaseLayout>
