---
import Icon from './Icon.astro';

export interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  back?: { href: string; label: string };
}

const { title, eyebrow, lead, back } = Astro.props;
const showEyebrow = eyebrow && !back;
---

<header class="page-hero">
  <div class="page-hero-inner reveal">
    {
      back && (
        <nav class="page-hero-nav" aria-label="Navigation secondaire">
          <a class="back-link" href={back.href}>
            <Icon name="arrow-left" size={18} />
            {back.label}
          </a>
        </nav>
      )
    }
    {showEyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="page-lead">{lead}</p>}
    <slot />
  </div>
</header>
