---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page introuvable | Fabien Blasquez"
  description="La page demandée n'existe pas."
  path="/404/"
>
  <div class="content-page" style="text-align:center;padding-top:80px">
    <h1 class="page-title">404</h1>
    <p style="color:var(--color-on-surface-variant)">Cette page n'existe pas ou a été déplacée.</p>
    <p style="margin-top:24px"><a class="btn-primary" href="/">Retour à l'accueil</a></p>
  </div>
</BaseLayout>
