---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
---

<BaseLayout
  title="Mentions légales | Fabien Blasquez"
  description="Mentions légales du site fabien-blasquez.dev."
  path="/mentions-legales/"
>
  <PageHero eyebrow="Informations" title="Mentions légales" />
  <div class="page-body">
    <div class="card empty-state reveal">
      <div class="card-icon"><Icon name="file" size={24} /></div>
      <div class="empty-state-body">
        <h2>En cours de rédaction</h2>
        <p>Mentions légales à venir.</p>
      </div>
    </div>
  </div>
</BaseLayout>
