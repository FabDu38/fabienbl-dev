---
import Icon from './Icon.astro';

export interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  back?: { href: string; label: string };
  portrait?: { src: string; alt: string };
}

const { title, eyebrow, lead, back, portrait } = Astro.props;
const showEyebrow = Boolean(eyebrow);
---

<header class="page-hero" class:list={{ 'page-hero--sub': Boolean(back), 'page-hero--portrait': Boolean(portrait) }}>
  <div class="page-hero-inner">
    {
      back && (
        <nav class="page-hero-nav" aria-label="Navigation secondaire">
          <a class="back-link back-link--hero" href={back.href}>
            <Icon name="arrow-left" size={18} />
            <span class="back-link-text">{back.label}</span>
          </a>
        </nav>
      )
    }
    <div class="page-hero-row">
      <div class="page-hero-content reveal">
        {showEyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{title}</h1>
        {lead && <p class="page-lead">{lead}</p>}
        <slot />
      </div>
      {
        portrait && (
          <img
            class="page-hero-portrait"
            src={portrait.src}
            alt={portrait.alt}
            width="640"
            height="640"
          />
        )
      }
    </div>
  </div>
</header>
