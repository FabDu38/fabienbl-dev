---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaPanel from '../../components/CtaPanel.astro';

const services = [
  {
    id: 'creer',
    title: 'Créer une application métier',
    text: 'Concevoir et développer un outil adapté aux usages réels d’une équipe, de l’idée à une solution utilisable.',
  },
  {
    id: 'evoluer',
    title: 'Faire évoluer un outil existant',
    text: 'Reprendre un outil déjà en place pour le clarifier, le fiabiliser et le faire évoluer.',
  },
  {
    id: 'automatiser',
    title: 'Automatiser des tâches et des échanges de données',
    text: 'Réduire les ressaisies et les échanges manuels entre outils.',
  },
  {
    id: 'cadrer',
    title: 'Cadrer et piloter un projet numérique',
    text: 'Cadrage et pilotage d’un projet, y compris lorsque le développement est réalisé par d’autres.',
  },
];
---

<BaseLayout
  title="Services | Fabien Blasquez"
  description="Créer une application métier, faire évoluer un outil, automatiser des échanges, cadrer et piloter un projet numérique."
  path="/services/"
>
  <PageHero
    eyebrow="Services"
    title="Services"
    lead="Quatre façons d’intervenir : construire un outil métier, le faire évoluer, automatiser des échanges, ou cadrer et piloter le projet."
  />

  <div class="page-body">
    <ol class="steps reveal">
      {
        services.map((service) => (
          <li id={service.id}>
            <strong>{service.title}</strong>
            {service.text}
          </li>
        ))
      }
    </ol>

    <section class="prose-section reveal">
      <h2>Méthode et preuves</h2>
      <div class="prose">
        <p>
          La façon de travailler est décrite sur la page <a href="/a-propos/">À propos</a>. Les contextes
          déjà menés sont sur <a href="/projets/professionnels/">Projets professionnels</a>.
        </p>
      </div>
    </section>

    <CtaPanel compact />
  </div>
</BaseLayout>
