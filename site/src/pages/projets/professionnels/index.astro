---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CtaPanel from '../../../components/CtaPanel.astro';
---

<BaseLayout
  title="Projets professionnels en entreprise | Fabien Blasquez"
  description="Expérience en environnement entreprise : Supplyframe/Siemens, Schneider Electric, applications métier et fiabilité."
  path="/projets/professionnels/"
>
  <PageHero
    back={{ href: '/projets/', label: 'Retour aux projets' }}
    title="Projets professionnels en entreprise"
    lead="Du développement au pilotage technique, ces réalisations présentent les besoins auxquels j’ai répondu et les responsabilités que j’ai exercées en entreprise."
  />

  <div class="page-body">
    <ol class="timeline">
      <li class="timeline-item reveal">
        <article class="card">
          <p class="project-kicker">Responsabilité technique · Management · Développement</p>
          <h2>Supplyframe (groupe Siemens)</h2>
          <h3>Faire évoluer un logiciel d’achats industriels</h3>
          <p>
            Pendant huit ans, un logiciel pour les équipes achats de l’industrie électronique.
          </p>
          <ul class="bullet-list">
            <li>Consultations fournisseurs, comparaison des offres, calcul des coûts des composants.</li>
            <li>Responsable technique : choix techniques et coordination des développements.</li>
            <li>Management direct de petites équipes, en agile.</li>
            <li>
              Module de consultation fournisseurs, puis migration lors du rachat par Supplyframe, avec
              des équipes à l’international.
            </li>
            <li>Nouvelles fonctionnalités et intégration d’API pour les données tarifaires des fournisseurs.</li>
          </ul>
        </article>
      </li>
      <li class="timeline-item reveal">
        <article class="card">
          <p class="project-kicker">Refonte applicative · Encadrement d’équipe · Recueil des besoins</p>
          <h2>Schneider Electric, Montbonnot</h2>
          <h3>Transformer un outil central de la supply chain</h3>
          <p>
            Sur le site de Montbonnot, un outil utilisé du commercial jusqu’à l’expédition :
            approvisionnement, ordonnancement et pilotage des lignes.
          </p>
          <ul class="bullet-list">
            <li>Correction des dysfonctionnements, maintenance et évolutions de l’outil en place.</li>
            <li>
              Migration, à mon initiative, vers une application web interne sur l’intranet du site.
            </li>
            <li>Développement et encadrement d’une équipe, jusqu’à la mise en production.</li>
            <li>Besoins recueillis directement auprès des équipes, puis traduits en évolutions.</li>
            <li>
              Application homologuée par le service informatique. Maintenance ensuite confiée à un
              prestataire.
            </li>
          </ul>
        </article>
      </li>
      <li class="timeline-item reveal">
        <article class="card">
          <p class="project-kicker">Développement · Évolution d’outils · Recueil des besoins</p>
          <h2>Schneider Electric, Fontanil</h2>
          <h3>Outiller le pilotage industriel et l’ordonnancement</h3>
          <p>Sur le site du Fontanil, deux chantiers distincts.</p>
          <ul class="bullet-list">
            <li>
              Outil de pilotage pour les comités de direction, dans la démarche SIOP : ventes, stocks et
              activité industrielle.
            </li>
            <li>
              Maintenance et nouvelles fonctionnalités des outils d’ordonnancement, à partir des besoins
              des équipes métier.
            </li>
          </ul>
        </article>
      </li>
      <li class="timeline-item reveal">
        <article class="card">
          <p class="project-kicker">Développement · Maintenance · Évolution d’outils</p>
          <h2>Alfa Laval</h2>
          <h3>Des outils pour les équipes techniques et commerciales</h3>
          <ul class="bullet-list">
            <li>Visualisation de modèles 3D pour le bureau d’études.</li>
            <li>Mise à jour des outils commerciaux : devis et suivi des commandes.</li>
          </ul>
        </article>
      </li>
      <li class="timeline-item reveal">
        <article class="card">
          <p class="project-kicker">Indépendant</p>
          <h2>BF Web Création</h2>
          <h3>Création de sites web en indépendant</h3>
          <p>
            Je prenais en charge l’ensemble du projet : échanges avec le client, création du site, mise
            en ligne et maintenance.
          </p>
        </article>
      </li>
    </ol>

    <CtaPanel compact />
  </div>
</BaseLayout>
