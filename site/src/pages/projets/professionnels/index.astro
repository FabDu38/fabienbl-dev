---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CtaPanel from '../../../components/CtaPanel.astro';
---

<BaseLayout
  title="Projets professionnels en entreprise | Fabien Blasquez"
  description="Expérience en environnement entreprise : Supplyframe/Siemens, Schneider Electric, applications métier et fiabilité."
  path="/projets/professionnels/"
>
  <PageHero
    back={{ href: '/projets/', label: 'Retour aux projets' }}
    eyebrow="Expérience"
    title="Projets professionnels en entreprise"
    lead="Les projets présentés ci-dessous reflètent mon expérience en environnement entreprise, sur des applications et outils métier intégrés à des contextes industriels, organisationnels et humains réels."
  />

  <div class="page-body">
    <ol class="timeline">
      <li class="timeline-item reveal">
        <article class="card">
          <p class="project-kicker">2017 à 2025</p>
          <h2>Supplyframe (groupe Siemens)</h2>
          <p>
            Développement applicatif, R&D et responsabilité technique : modules web, modernisation,
            collaboration internationale, responsabilité du logiciel historique Windev utilisé par de
            grands comptes — maintenance, évolutions et relation client.
          </p>
        </article>
      </li>
      <li class="timeline-item reveal">
        <article class="card">
          <p class="project-kicker">Grand groupe</p>
          <h2>Schneider Electric</h2>
          <p>
            Projets structurants au sein d'un grand groupe, autour d'outils métier et de la fiabilité
            des solutions livrées.
          </p>
        </article>
      </li>
      <li class="timeline-item reveal">
        <article class="card">
          <p class="project-kicker">Indépendant</p>
          <h2>Parcours indépendant & web</h2>
          <p>
            Plusieurs années en indépendant dans le développement web avant d'évoluer sur des projets
            plus structurants en entreprise.
          </p>
        </article>
      </li>
    </ol>

    <CtaPanel compact />
  </div>
</BaseLayout>
