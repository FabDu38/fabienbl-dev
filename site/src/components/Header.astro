---
export interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const links = [
  { href: '/', label: 'Accueil' },
  { href: '/projets/', label: 'Projets' },
  { href: '/a-propos/', label: 'À propos' },
  { href: '/contact/', label: 'Contact' },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/' || currentPath === '';
  return currentPath.startsWith(href.replace(/\/$/, ''));
}
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/">
      <span class="brand-wide">Fabien Blasquez – Développeur Web</span>
      <span class="brand-short" style="display:none">Fabien Blasquez</span>
    </a>
    <nav class="nav-desktop" aria-label="Navigation principale">
      {links.map((link) => (
        <a
          class="nav-link"
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <button
      type="button"
      class="menu-toggle"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Ouvrir le menu"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z"></path>
      </svg>
    </button>
  </div>
  <nav id="mobile-nav" class="mobile-nav" data-mobile-nav aria-label="Navigation mobile">
    {links.map((link) => (
      <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
        {link.label}
      </a>
    ))}
  </nav>
</header>

<style>
  @media (max-width: 839px) {
    .brand-wide {
      display: none !important;
    }
    .brand-short {
      display: inline !important;
    }
  }
</style>
