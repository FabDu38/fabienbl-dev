---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import Icon from '../../components/Icon.astro';
---

<BaseLayout
  title="Projets | Fabien Blasquez"
  description="Projets professionnels et études de cas : applications métier, portfolio et démarche de conception."
  path="/projets/"
>
  <PageHero
    eyebrow="Réalisations"
    title="Projets"
    lead="Les projets présentés ici illustrent ma démarche de conception et ma façon de structurer des applications, plus qu'une vitrine exhaustive de réalisations."
  />

  <div class="page-body">
    <div class="project-grid">
      <article class="card project-card project-card--featured reveal">
        <p class="project-kicker">Applications et outils métier</p>
        <h2>Projets professionnels en entreprise</h2>
        <p>
          Projets réalisés en environnement entreprise, sur des applications et outils métier, du
          cadrage à la mise en production.
        </p>
        <div class="card-footer">
          <ul class="tags">
            <li class="tag">Applications métier</li>
            <li class="tag">Contexte industriel</li>
          </ul>
          <a class="card-link" href="/projets/professionnels/">
            Voir le détail <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </article>

      <article class="card project-card reveal">
        <p class="project-kicker">Application Flutter Web</p>
        <h2>Portfolio professionnel</h2>
        <p>
          Application Flutter Web servant de vitrine professionnelle et de socle technique
          multiplateforme (remplacée par ce site Astro).
        </p>
        <div class="card-footer">
          <ul class="tags">
            <li class="tag">Flutter</li>
            <li class="tag">Web</li>
          </ul>
          <a class="card-link" href="/projets/portfolio/">
            Étude de cas <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </article>

      <article class="card project-card reveal">
        <p class="project-kicker">Application Flutter — en cours</p>
        <h2>Outil de suivi d'activités et d'objectifs</h2>
        <p>
          Projet en cours autour de la structuration des données, de la navigation et de
          l'évolutivité.
        </p>
        <div class="card-footer">
          <ul class="tags">
            <li class="tag">Flutter</li>
            <li class="tag tag--muted">En cours</li>
          </ul>
        </div>
      </article>
    </div>

    <CtaPanel compact />
  </div>
</BaseLayout>
