---
/*
  Archive — hors routes (séance Parcours, 29/09/2026).
  Conservé pour un éventuel retour. Ne pas replacer dans src/pages/
  tant que /projets/portfolio/ doit rester une 301 vers /projets/.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaPanel from '../components/CtaPanel.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Étude de cas — Portfolio professionnel | Fabien Blasquez"
  description="Étude de cas : conception d'une application Flutter Web comme vitrine professionnelle et socle multiplateforme."
  path="/projets/portfolio/"
>
  <PageHero
    back={{ href: '/projets/', label: 'Retour aux projets' }}
    title="Portfolio professionnel"
    lead="Application Flutter Web conçue comme une vitrine professionnelle et un socle technique multiplateforme."
  >
    <ul class="tags">
      <li class="tag">Flutter Web</li>
      <li class="tag">Multiplateforme</li>
      <li class="tag">Responsive</li>
    </ul>
  </PageHero>

  <div class="page-body">
    <div>
      <section class="prose-section reveal">
        <h2>Contexte & intention</h2>
        <div class="prose">
          <p>
            Ce projet correspondait à mon site professionnel : une application Flutter Web structurée,
            vitrine et base technique pour des évolutions futures, avec des contraintes réelles de
            lisibilité, maintenabilité et déploiement.
          </p>
        </div>
      </section>

      <section class="prose-section reveal">
        <h2>Problématique</h2>
        <ul class="check-list">
          <li>lisible sur tous les formats (desktop, tablette, mobile),</li>
          <li>simple à maintenir et à faire évoluer,</li>
          <li>sans sur-ingénierie inutile,</li>
          <li>tout en respectant une logique de produit claire.</li>
        </ul>
      </section>

      <section class="prose-section reveal">
        <h2>Approche & mise en œuvre</h2>
        <ul class="check-list">
          <li>organisation modulaire des écrans et des sections</li>
          <li>composants réutilisables</li>
          <li>navigation multi-pages</li>
          <li>gestion du responsive</li>
          <li>animations légères et maîtrisées</li>
        </ul>
      </section>

      <section class="prose-section reveal">
        <h2>Choix techniques</h2>
        <div>
          <ul class="check-list">
            <li>Flutter Web comme socle principal</li>
            <li>approche multiplateforme dès la conception</li>
            <li>codebase unique, structuré pour évoluer</li>
          </ul>
          <p class="callout">
            <Icon name="info" size={20} />
            <span>
              Le site public a migré vers <strong>Astro</strong> (MVP2) pour un HTML indexable natif,
              tout en conservant la même promesse et navigation.
            </span>
          </p>
        </div>
      </section>
    </div>

    <CtaPanel compact />
  </div>
</BaseLayout>
